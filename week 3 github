#linked list insertion in middle def insertMiddle(head, x): if not head: return Node(x) slow, fast = head, head.next while fast and fast.next: slow = slow.next fast = fast.next.next new = Node(x) new.next = slow.next slow.next = new return head

#linked list delete a node at position def deleteNode(head, pos): if not head or pos <= 0: return head if pos == 1: return head.next cur = head for _ in range(pos‑2): if not cur.next: return head cur = cur.next if cur.next: cur.next = cur.next.next return head

#linked list search def search(head, key): cur = head while cur: if cur.data == key: return True cur = cur.next return False

#linklist nth node from end def nthFromEnd(head, n): fast = slow = head for _ in range(n): if not fast: return None fast = fast.next while fast: fast = fast.next slow = slow.next return slow # or slow.data

#linked list delete loop def detectLoop(head): slow = fast = head while fast and fast.next: slow = slow.next fast = fast.next.next if slow is fast: return True return False